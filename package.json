{
  "name": "vue3-bootstrap-components",
  "version": "3.0.2",
  "description": "Bootstrap 6 components for Vue 3 — lazy-loaded Bootstrap JavaScript, typed props, full event support, no bundled CSS.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts"
    },
    "./package.json": "./package.json",
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "global": [
        "./dist/global.d.ts"
      ],
      "plugin": [
        "./dist/plugin.d.ts"
      ],
      "composables": [
        "./dist/composables.d.ts"
      ],
      "components/*": [
        "./dist/components/*/index.d.ts"
      ],
      "plugins/*": [
        "./dist/plugins/*.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-indexes.mjs",
    "build": "npm run generate && vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "vue",
    "vue3",
    "bootstrap",
    "bootstrap6",
    "bootstrap-6",
    "components",
    "laravel",
    "inertia",
    "novinvision"
  ],
  "author": "NovinVision",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novinvision/vue-bootstrap-components.git"
  },
  "homepage": "https://github.com/novinvision/vue-bootstrap-components#readme",
  "bugs": {
    "url": "https://github.com/novinvision/vue-bootstrap-components/issues"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6"
  },
  "peerDependencies": {
    "bootstrap": "^6.0.0-alpha.1",
    "vanilla-calendar-pro": "^3.4.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vanilla-calendar-pro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "bootstrap": "6.0.0-alpha.1",
    "happy-dom": "^15.11.7",
    "typescript": "~5.6.3",
    "vanilla-calendar-pro": "^3.4.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
